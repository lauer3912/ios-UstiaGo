default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :upload_testflight do |options|
    api_key = ENV.fetch('APPSTORE_API_KEY_CONTENT', '')
    
    puts "API key length: #{api_key.length}"
    
    # Pass api_key directly as a hash
    pilot(
      api_key: {
        key_id: 'H3973L93M5',
        issuer_id: 'b2a00f88-3a8d-40d0-b148-1f1db92e10b7',
        key: api_key
      },
      app_platform: 'ios',
      app_identifier: 'com.ggsheng.UstiaGo',
      ipa: File.expand_path('../../build/UstiaGo.ipa', __dir__)
    )
  end
end
