default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :upload_testflight do |options|
    api_key = ENV.fetch('APPSTORE_API_KEY_CONTENT', '')
    
    # Use absolute path
    key_path = File.expand_path('../fastlane/api_key.json', Dir.pwd)
    
    File.write(key_path, {
      key_id: 'H3973L93M5',
      issuer_id: 'b2a00f88-3a8d-40d0-b148-1f1db92e10b7',
      key: api_key
    }.to_json)
    
    puts "API key file at: #{key_path}, exists: #{File.exist?(key_path)}"
    
    pilot(
      api_key_path: key_path,
      app_platform: 'ios',
      app_identifier: 'com.ggsheng.UstiaGo',
      ipa: File.expand_path('../build/UstiaGo.ipa', Dir.pwd)
    )
  end
end
